# Local generation (GCP is not required)
OPENAI_API_KEY=
PEXELS_API_KEY=
SCRIPT_MODEL=gpt-4o
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=onyx
TTS_SPEED=1.1
# auto uses ElevenLabs when its key is configured, otherwise OpenAI
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_multilingual_v2
SHORTS_BACKEND=sqlite
SHORTS_SYNC_GCS=false
# SHORTS_OUTPUT_DIR=C:/path/to/output/jobs
# KOREAN_FONT=C:/Windows/Fonts/malgun.ttf
# FFMPEG_BINARY=C:/path/to/ffmpeg.exe

# Required for access beyond localhost: use a random 32+ character key
SHORTS_API_TOKEN=
SHORTS_BASE_URL=

# Optional Reddit trends (Hacker News works without a key)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TechShortsStudio/3.0

# Optional GCP persistence / signed Instagram download URL
GCP_PROJECT_ID=
STORAGE_BUCKET_NAME=
GCS_SIGNING_SERVICE_ACCOUNT=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Optional YouTube OAuth credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Optional TikTok application with video.publish permission
TIKTOK_ACCESS_TOKEN=

# Optional Instagram professional account with Facebook Login
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Set a version enabled for your Meta app, e.g. v25.0
META_API_VERSION=

# Optional Gmail review links (emails are sent only by an explicit UI/API action)
ADMIN_EMAIL=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
